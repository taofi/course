{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@src/*": [
        "src/*"
      ],
      "@express/*": [
        "src/express/*"
      ],
      "@db/*": [
        "src/db/*"
      ],
      "@munchkin/shared": [
        "../shared/index.ts"
      ]
    },
    
    // Environment Settings
    "module": "CommonJS", // <-- CommonJS вместо NodeNext
    "moduleResolution": "Node", // <-- Node вместо NodeNext
    "target": "ES2020",
    "types": [
      "node",
      "jest"
    ],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    // Style Options
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
      "src/**/*",
      "../shared/**/*" 
    ],
}